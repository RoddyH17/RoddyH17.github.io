---
// Archive: every post, grouped by subject rather than by year.
//
// Why not chronological: the old version grouped by year and hung an MM-DD on
// each row, which answered a question nobody was asking. What is actually being
// archived here is a curriculum — the Rust log is a sequence where Day 1 leads
// to Day 8 — and a sequence wants reading order, not filing order. Dates carry
// no meaning for a reader landing on this page, so they are not shown anywhere.
//
// Two ordering rules, both stated once and applied everywhere:
//   groups — largest first, ties alphabetical. The main body of work leads.
//   inside — by series number when the title carries one ("Day 7.5 · …"),
//            otherwise oldest first.
//
// The series number, not the date, is what orders a curriculum: Day 5.5 was
// written after Day 6 but belongs between 5 and 6, and sorting by pubDate puts
// it in the wrong place. Numbered posts lead the group; anything unnumbered
// follows in the order it was written.
import SiteSeo from '~/components/SiteSeo.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import type { Post } from '~/types'
import { getCategories, getPosts } from '~/utils'

/** "Day 7.5 · Option and Result" → 7.5. Anything else → null. */
const SERIES_RE = /^\p{L}+\s+(\d+(?:\.\d+)?)\s*[·:]/u

const SUBJECT_META: Record<string, string> = {
  rust: 'Sequential curriculum',
  crypto: 'Independent stream',
}

const categoryMap = await getCategories()
const total = (await getPosts(true)).length

const groups = Array.from(categoryMap)
  .map(([name, posts]) => ({
    name,
    id: name.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
    description: SUBJECT_META[name.toLowerCase()] ?? 'Independent subject',
    // getCategories() inherits the feed's newest-first order; a series reads forward.
    posts: [...posts].reverse().map(toEntry).sort(bySeriesThenAge),
  }))
  .sort((a, b) => b.posts.length - a.posts.length || a.name.localeCompare(b.name))

function toEntry(post: Post) {
  const title = post.data.title
  const match = SERIES_RE.exec(title)
  const series = Number(match?.[1] ?? Number.NaN)
  return {
    title: match ? title.slice(match[0].length).trim() : title,
    href: `/posts/${post.id}/`,
    series,
    label: Number.isNaN(series) ? null : `Day ${series}`,
  }
}

function bySeriesThenAge(a: { series: number }, b: { series: number }) {
  if (Number.isNaN(a.series) && Number.isNaN(b.series)) return 0
  if (Number.isNaN(a.series)) return 1
  if (Number.isNaN(b.series)) return -1
  return a.series - b.series
}
---

<LayoutDefault page="archive">
  <SiteSeo slot="seo" title="Archive" desc="Every post, grouped by subject and listed in reading order." />

  <section class="prose">
    <h2 class="archive-title post-title">Archive</h2>

    <p class="lead">
      Everything written here, grouped by what it is about and listed in reading order. The Rust log is a sequence — it
      runs from the top down, not newest first.
    </p>

    <p class="op-55 text-3.5">
      {total} posts in {groups.length}
      {groups.length === 1 ? 'subject' : 'subjects'}. Protocol research lives in its own matrix, over in <a
        href="/research">Research</a
      >.
    </p>

    <nav class="subject-index" aria-label="Archive subjects">
      <p>Subject index</p>
      <ul>
        {
          groups.map(({ id, name, description, posts }) => (
            <li>
              <a href={`#${id}`}># {name}</a>
              <span>
                {description} ({posts.length})
              </span>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      groups.map(({ id, name, description, posts }) => (
        <section id={id} class="subject-section">
          <header class="subject-heading">
            <h3 class="post-title"># {name}</h3>
            <p>
              {description} ({posts.length})
            </p>
          </header>
          <ul class="entries">
            {posts.map(({ title, href, label }) => (
              <li class:list={{ unsequenced: !label }}>
                <span class="timeline-marker i-mdi-circle-outline" aria-hidden="true" />
                {label && <span class="entry-label">{label}</span>}
                <a href={href}>{title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</LayoutDefault>

<style>
  .lead {
    font-size: 1.15rem;
    line-height: 1.65;
  }

  .archive-title {
    font-size: 2rem;
    line-height: 1.2;
  }

  section.prose > .subject-index,
  section.prose > .subject-section {
    max-width: none;
  }

  .subject-index {
    margin-top: 1.25rem;
    padding: 0.75rem 0 0.85rem;
    border-top: 1px solid color-mix(in srgb, currentColor 13%, transparent);
    border-bottom: 1px solid color-mix(in srgb, currentColor 13%, transparent);
  }

  .subject-index > p {
    margin: 0 0 0.65rem;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  .subject-index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .subject-index li {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin: 0;
  }

  .subject-index li + li::before {
    content: '·';
    margin-right: 1.2rem;
    opacity: 0.45;
  }

  .subject-index span,
  .subject-heading p {
    font-size: 0.82rem;
    opacity: 0.55;
  }

  .subject-section {
    max-width: none;
    margin-top: 1rem;
    scroll-margin-top: 2rem;
  }

  .subject-section + .subject-section {
    padding-top: 1.65rem;
    border-top: 1px solid color-mix(in srgb, currentColor 14%, transparent);
  }

  .subject-heading {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }

  .subject-heading h3,
  .subject-heading p {
    margin: 0;
  }

  .subject-heading h3 {
    font-size: 1.4rem;
  }

  /* A single guide and hairline rows turn the Rust posts into a reading path
     without wrapping every entry in a separate card. */
  .entries {
    position: relative;
    list-style: none;
    margin: 0.85rem 0 0 0.45rem;
    padding: 0 0 0 1.35rem;
    border-left: 1px solid color-mix(in srgb, currentColor 42%, transparent);
  }

  .entries li {
    position: relative;
    display: grid;
    grid-template-columns: 6.2rem minmax(0, 1fr);
    align-items: baseline;
    column-gap: 1rem;
    margin: 0;
    padding: 0.15rem 0 0.15rem 0.15rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  }

  .entries li:last-child {
    border-bottom: none;
  }

  .entries li.unsequenced {
    grid-template-columns: minmax(0, 1fr);
  }

  .timeline-marker {
    position: absolute;
    top: 0.39rem;
    left: -1.75rem;
    width: 0.8rem;
    height: 0.8rem;
    color: currentColor;
  }

  .entry-label {
    font-size: 0.82rem;
    white-space: nowrap;
    opacity: 0.78;
  }

  @media (max-width: 640px) {
    .subject-index ul,
    .subject-index li,
    .subject-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .subject-index li {
      gap: 0.15rem;
    }

    .subject-index li + li::before {
      display: none;
    }

    .entries li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
