---
// Learning-log widget for the right column: a contribution heatmap.
//
// The heatmap lights a cell for ANY published day — every posts category plus
// research notes, not just the Rust series. It used to filter on
// categories.includes('rust'), which silently left a hole on days whose only
// output was a crypto post or a research note (2026-08-05 was blank despite
// the Uniswap note shipping that day).
//
// Mood was dropped 2026-08-11: it used to add a "Mood Spread" histogram and to
// set each cell's shade (zen < frage < sorge). Every lit cell now uses the same
// opacity — publishing is the only thing the grid reports. The `mood` field is
// still allowed in frontmatter (it's a private authoring tag), it just isn't
// rendered anywhere.
// Colors use only the theme variables, so light/dark mode works automatically.
import { getCollection } from 'astro:content'

const posts = await getCollection('posts', ({ data }) => !data.draft)
const research = await getCollection('research', ({ data }) => !data.draft)

interface DayLog {
  date: Date
  dayNum: number | null
  titles: string[]
}

// Frontmatter dates are UTC midnight, so read them with UTC accessors;
// the calendar grid below is also built in UTC to match.
const dateKey = (d: Date) =>
  `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}-${String(d.getUTCDate()).padStart(2, '0')}`

const published = [
  ...posts.map((p) => ({ date: p.data.pubDate, title: p.data.title })),
  ...research.map((r) => ({ date: r.data.pubDate, title: r.data.title })),
]

// Group by day, because more than one thing can ship on the same date and a day
// only has one cell. Merging (rather than overwriting) keeps every title in the
// tooltip.
const byDate = new Map<string, DayLog>()
for (const item of published) {
  const key = dateKey(item.date)
  const log = byDate.get(key) ?? { date: item.date, dayNum: null, titles: [] }
  log.titles.push(item.title)
  // Half-days are their own day (Day 5.5 is not Day 5), so the fraction has to
  // be part of the capture — `\d+` alone reads "Day 5.5" as 5 and mislabels the
  // cell. Same prefix collision the pipeline audit hit.
  const dayMatch = item.title.match(/Day\s+(\d+(?:\.\d+)?)/i)
  if (dayMatch) log.dayNum = Number(dayMatch[1])
  byDate.set(key, log)
}

// ---------- Heatmap: last 12 weeks, Sunday-first columns ----------
// One opacity for every published day. This is the value a mood-less day already
// used, so days that never carried a tag look exactly as they did before.
const LIT_ALPHA = 0.5

const WEEKS = 12
const PITCH = 16
const CELL = 12
const now = new Date()
// "today" as a UTC date carrying the local calendar date
const today = new Date(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()))
const start = new Date(today)
start.setUTCDate(start.getUTCDate() - start.getUTCDay() - (WEEKS - 1) * 7)

interface Cell {
  x: number
  y: number
  alpha: number | null
  label: string
}
const cells: Cell[] = []
for (let w = 0; w < WEEKS; w++) {
  for (let d = 0; d < 7; d++) {
    const date = new Date(start)
    date.setUTCDate(start.getUTCDate() + w * 7 + d)
    if (date > today) continue
    const log = byDate.get(dateKey(date))
    cells.push({
      x: w * PITCH,
      y: d * PITCH,
      alpha: log ? LIT_ALPHA : null,
      // Rust days are identified by number. Anything else — and any extra item
      // shipped the same day — is named by title, so a lit cell always says
      // what was actually published rather than silently hiding a second post.
      label: log
        ? [
            log.dayNum ? `Day ${log.dayNum}` : null,
            dateKey(date),
            log.dayNum && log.titles.length === 1 ? null : log.titles.join(' + '),
          ]
            .filter(Boolean)
            .join(' · ')
        : dateKey(date),
    })
  }
}
const heatW = WEEKS * PITCH - (PITCH - CELL)
const heatH = 7 * PITCH - (PITCH - CELL)
---

<aside class="learning-pulse">
  <section>
    <h3>Toxicity</h3>
    <svg viewBox={`0 0 ${heatW} ${heatH}`} width="100%" role="img" aria-label="Daily learning heatmap">
      {
        cells.map((c) => (
          <rect
            x={c.x}
            y={c.y}
            width={CELL}
            height={CELL}
            rx="1"
            fill={c.alpha != null ? 'var(--uno-colors-primary)' : 'none'}
            fill-opacity={c.alpha ?? undefined}
            stroke="var(--uno-colors-primary)"
            stroke-opacity={c.alpha != null ? 0 : 0.18}
          >
            <title>{c.label}</title>
          </rect>
        ))
      }
    </svg>
  </section>
</aside>

<style>
  .learning-pulse {
    display: none;
  }

  @media (min-width: 1024px) {
    .learning-pulse {
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
      margin-top: 2.5rem;
      max-width: 15rem;
    }
  }

  .learning-pulse h3 {
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.75;
    margin-bottom: 0.6rem;
    font-weight: normal;
  }

  .learning-pulse svg {
    overflow: visible;
  }
</style>
