---
import type { Post } from '~/types'
import PostCategory from './PostCategory.astro'

interface Props {
  post: Post
  // 'list': linked title + categories (no date, no mood — mood stays private).
  // 'post': plain title only.
  mode?: 'list' | 'post'
}

const { post, mode = 'list' } = Astro.props

const categoryList = post.data.categories ?? []
---

<header flex="~ col gap-2">
  <h1 class="post-title">
    {
      mode === 'list' ? (
        <a class="not-prose" href={`/posts/${post.id}/`}>
          {post.data.title}
        </a>
      ) : (
        post.data.title
      )
    }
  </h1>
  {
    mode === 'list' && (
      <div class="text-3.5">
        {categoryList.map((category) => (
          <PostCategory category={category} />
        ))}
      </div>
    )
  }
</header>
