---
import type { Post } from '~/types'

interface Props {
  post: Post
  // 'list': linked title only (no date, categories, or mood).
  // 'post': plain title only.
  mode?: 'list' | 'post'
}

const { post, mode = 'list' } = Astro.props
---

<header flex="~ col gap-2">
  <h1 class="post-title">
    {
      mode === 'list' ? (
        <a class="not-prose" href={`/posts/${post.id}/`}>
          {post.data.title}
        </a>
      ) : (
        post.data.title
      )
    }
  </h1>
</header>
