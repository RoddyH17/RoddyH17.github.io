---
import PostMeta from '~/components/PostMeta.astro'
import type { Post } from '~/types'

interface Props {
  post: Post
  mode?: 'list' | 'post'
}

const { post, mode = 'list' } = Astro.props
---

<article class="prose">
  {mode === 'list' && <PostMeta post={post} mode={mode} />}
  <slot />
</article>
